@page "/admin"
@inject LoadingStateService LoadingState
@inject DefuseService Defuse
@implements IDisposable

<PageTitle>Admin</PageTitle>

<h1>Admin</h1>

@if (!Armed && Defuse.State == DefuseState.Idle)
{
    <button
        class="btn btn-primary btn-lg"
        @onpointerdown="StartLoad"
        @onpointerup="StopLoad"
        @onpointerleave="StopLoad"
        @onpointercancel="StopLoad">
        Load
    </button>
}

@if (Armed && Defuse.State is DefuseState.Idle or DefuseState.Defusing)
{
    <button
        class="btn btn-danger btn-lg defuse-btn"
        @onpointerdown="StartDefuse"
        @onpointerup="StopDefuse"
        @onpointerleave="StopDefuse"
        @onpointercancel="StopDefuse">
        Defuse
    </button>
}

@if (Defuse.State == DefuseState.Defusing || Defuse.State == DefuseState.Idle)
{
    <div class="defuse-progress">
        <div class="defuse-progress-fill" style="width: @(Defuse.DefuseProgress * 100)%"></div>
    </div>
}

<button class="btn btn-secondary btn-lg" @onclick="ResetRound">
    Reset
</button>

@code {
    // armed once loading reached 100%; stays armed until Reset, also across page reloads
    private bool Armed => LoadingState.Progress == 100;

    protected override void OnInitialized()
    {
        Defuse.OnChange += OnStateChanged;
        LoadingState.OnChange += OnStateChanged;
    }

    private void StartLoad() => LoadingState.StartLoading();

    private void StopLoad()
    {
        if (Armed) return;
        LoadingState.StopLoading();
    }

    private void StartDefuse() => Defuse.StartDefuse();

    private void StopDefuse() => Defuse.StopDefuse();

    private void ResetRound()
    {
        LoadingState.Reset();
        Defuse.Reset();
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Defuse.OnChange -= OnStateChanged;
        LoadingState.OnChange -= OnStateChanged;
    }
}
