@page "/admin"
@inject LoadingStateService LoadingState

<PageTitle>Admin</PageTitle>

<h1>Admin</h1>

<button
    class="btn btn-primary btn-lg"
    @onpointerdown="StartLoad"
    @onpointerup="StopLoad"
    @onpointerleave="StopLoad"
    @onpointercancel="StopLoad">
    Load
</button>

@code {
    void StartLoad() => LoadingState.StartLoading();
    void StopLoad() => LoadingState.StopLoading();
}
