@page "/admin"
@inject LoadingStateService LoadingState
@inject DefuseService Defuse
@implements IDisposable

<PageTitle>Admin</PageTitle>

<h1>Admin</h1>

<button
    class="btn btn-primary btn-lg"
    disabled="@_bombArmed"
    @onpointerdown="StartLoad"
    @onpointerup="StopLoad"
    @onpointerleave="StopLoad"
    @onpointercancel="StopLoad">
    Load
</button>

@if (_bombArmed && Defuse.State == DefuseState.Idle)
{
    <button
        class="btn btn-danger btn-lg defuse-btn"
        @onclick="StartDefuse">
        Defuse
    </button>
}

@if (Defuse.State == DefuseState.Defusing)
{
    <div class="defuse-progress">
        <div class="defuse-progress-fill" style="width: @(Defuse.DefuseProgress * 100)%"></div>
    </div>
}

@code {
    private bool _bombArmed;

    protected override void OnInitialized()
    {
        Defuse.OnChange += OnDefuseStateChanged;
        LoadingState.OnChange += OnLoadingStateChanged;
    }

    private void StartLoad() => LoadingState.StartLoading();

    private void StopLoad()
    {
        if (_bombArmed) return;
        LoadingState.StopLoading();
    }

    private void StartDefuse() => Defuse.StartDefuse();

    private void OnDefuseStateChanged()
    {
        if (Defuse.State is DefuseState.Defused or DefuseState.Detonated)
            _bombArmed = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnLoadingStateChanged()
    {
        if (LoadingState.Progress == 100 && !_bombArmed)
            _bombArmed = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Defuse.OnChange -= OnDefuseStateChanged;
        LoadingState.OnChange -= OnLoadingStateChanged;
    }
}
