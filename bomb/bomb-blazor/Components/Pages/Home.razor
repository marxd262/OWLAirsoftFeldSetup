@page "/"
@implements IDisposable

<PageTitle>Home</PageTitle>
<div class="scanlines"/>
<div class="intro-wrap">
    <div class="noise" />
    <div class="noise noise-moving" />

    @switch (_bombState)
    {
        case BombState.Standby:
            <h1 class="play">Standby<span class="cursor">_</span></h1>
            break;
        case BombState.Activating:
            <Activating />
            break;
        case BombState.Active:
            <Active OnDetonated="HandleDetonation" OnDefused="HandleDefused" />
            break;
        case BombState.Defused:
            <h1 class="text-defused">DEFUSED</h1>
            break;
        case BombState.Detonated:
            <Boom />
            break;
    }

</div>
